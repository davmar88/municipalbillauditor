# Base URL of the Laravel API, including /api/v1. Copy this file to .env and adjust.
# If unset, the app uses http://10.0.2.2:8000/api/v1 on the Android emulator
# and http://localhost:8000/api/v1 everywhere else (iOS simulator, web).
# On a physical phone with Expo Go, use your computer's LAN address, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_URL=
