# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
vendor/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# build output and test reports
build/
coverage/
*.tsbuildinfo

# Native (generated by prebuild; never edit by hand)
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.apk
*.aab
*.ipa

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# environment files: only .env.example is committed
.env
.env.*
!.env.example

# local databases and uploaded or downloaded files
*.sqlite
*.sqlite3
*.db
uploads/
