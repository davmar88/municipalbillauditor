APP_NAME="Municipal Bill Auditor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for local development (database/database.sqlite).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync runs bill extraction inline during the upload request in development.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Deadline reminder emails are written to storage/logs in development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="reminders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Web (Vite) and mobile (Expo) dev origins allowed by CORS for api/*.
FRONTEND_URLS=http://localhost:5173,http://localhost:8081

# AI bill extraction (optional). Leave the key empty to disable it; users
# then type in their line items. Only used for users who opted in.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
