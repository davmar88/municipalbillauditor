APP_NAME="Municipal Bill Auditor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=municipal_bill_auditor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Bills are personal financial data: keep them on a private disk, never "public".
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reading bills. Without a key, uploaded bills wait for manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_BILL_MODEL=
# Reading municipal replies to disputes. Defaults to the bill model.
ANTHROPIC_REPLY_MODEL=

# Inbound email: customers forward e-bills to <code>@INBOUND_EMAIL_DOMAIN and
# municipalities reply to disputes at d-<token>@INBOUND_EMAIL_DOMAIN. Point
# the provider's inbound route at APP_URL/inbound/email. Mailgun signs each
# post with MAILGUN_WEBHOOK_SIGNING_KEY; other providers can send
# INBOUND_EMAIL_SECRET in an X-Inbound-Secret header instead.
INBOUND_EMAIL_DOMAIN=bills.example.com
INBOUND_EMAIL_SECRET=
MAILGUN_WEBHOOK_SIGNING_KEY=

CONTACT_EMAIL=
COMPANY_NAME=
INFORMATION_OFFICER=

# Prices in rand. Pay as you go: every account pays per job from prepaid
# credit, with no monthly or setup fees.
PRICE_JOB_BILL_CHECK=15
PRICE_JOB_DISPUTE=49
TOP_UP_PACKS=50,100,250,500
WELCOME_CREDIT=0

# What Claude costs us is converted to rand at this rate for the margin report.
USD_ZAR_RATE=18.50

# "Continue with Google". The OAuth client's authorised redirect URI is
# APP_URL/auth/google/callback. Without these, the button doesn't show.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Card payments. Test keys put Paystack in test mode. With an account of its
# own, point Paystack's webhook at APP_URL/webhooks/paystack. Sharing another
# site's account, leave the webhook alone: payments:reconcile asks Paystack
# about open payments every five minutes.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
